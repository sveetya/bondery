{
  "dependencies": {
    "@bondery/branding": "workspace:*",
    "@bondery/helpers": "workspace:*",
    "@bondery/mantine-next": "workspace:*",
    "@bondery/schemas": "workspace:*",
    "@bondery/translations": "workspace:*",
    "@mantine/core": "^9.5.0",
    "@mantine/hooks": "^9.5.0",
    "@react-email/ui": "^6.9.1",
    "@tabler/icons-react": "^3.46.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "fastify-zod-openapi": "^5.7.0",
    "flag-icons": "^7.5.0",
    "i18next": "^26.3.6",
    "i18next-cli": "^1.67.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1",
    "react-i18next": "^17.0.11",
    "transliteration": "^2.6.1"
  },
  "description": "Bondery Extension",
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@wxt-dev/module-react": "^1.2.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "web-ext": "^9.2.0",
    "wxt": "^0.21.2"
  },
  "name": "chrome-extension",
  "private": true,
  "scripts": {
    "build": "pnpm exec wxt build",
    "build:firefox": "pnpm exec wxt build -b firefox",
    "check:env": "tsx scripts/check-env.ts",
    "check:extension-patterns": "tsx scripts/check-extension-patterns.ts",
    "check:types": "node ../../scripts/tsc-native.mjs --noEmit",
    "dev": "pnpm exec wxt",
    "dev:firefox": "pnpm exec wxt -b firefox",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "postinstall": "wxt prepare",
    "prebuild": "tsx scripts/generate-icons.ts",
    "zip": "pnpm exec wxt zip",
    "zip:firefox": "pnpm exec wxt zip -b firefox"
  },
  "type": "module",
  "version": "1.8.3"
}

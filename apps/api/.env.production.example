# Generated by npm run env — do not edit by hand. Edit root .env.local instead.


# --- AI ---
# Anthropic API key for AI features
BONDERY_PRIVATE_ANTHROPIC_API_KEY=sk-ant-<your-anthropic-api-key>

# --- Analytics ---
# PostHog personal API key for admin analytics queries (optional)
BONDERY_PRIVATE_POSTHOG_API_SECRET=""
# PostHog project id for admin analytics queries (optional)
BONDERY_PRIVATE_POSTHOG_PROJECT_ID=""
# Disable analytics / vendor telemetry when true
DO_NOT_TRACK=true

# --- API secrets ---
# Internal service-to-service HMAC secret
BONDERY_PRIVATE_SERVICE_SECRET=<your-service-secret>

# --- Auth ---
# GitHub OAuth client id for Better Auth
BONDERY_PRIVATE_AUTH_GITHUB_CLIENT_ID=""
# GitHub OAuth client secret for Better Auth
BONDERY_PRIVATE_AUTH_GITHUB_CLIENT_SECRET=""
# LinkedIn OAuth client id for Better Auth
BONDERY_PRIVATE_AUTH_LINKEDIN_CLIENT_ID=""
# LinkedIn OAuth client secret for Better Auth
BONDERY_PRIVATE_AUTH_LINKEDIN_CLIENT_SECRET=""
# Better Auth versioned secrets (format: version:secret[,version:secret...]; highest version first)
BONDERY_PRIVATE_BETTER_AUTH_SECRETS=1:your-super-secret-better-auth-secret-min-32-chars
# Webapp's own OAuth client secret (never exposed to the browser). The API only ever stores/verifies its hash via deployment-time provisioning; it never round-trips the plaintext value.
BONDERY_PRIVATE_WEBAPP_OAUTH_CLIENT_SECRET=""
# Chrome extension OAuth client id (synced as legacy name below). Also consumed by the API's deployment-time OAuth client provisioning.
BONDERY_PUBLIC_OAUTH_CLIENT_ID=""
# Webapp's own OAuth client id (confidential BFF client of the API's oauth-provider)
BONDERY_PUBLIC_WEBAPP_OAUTH_CLIENT_ID=""

# --- Database ---
# Postgres connection string (Prisma + API)
DATABASE_URL=postgresql://postgres:password@127.0.0.1:54322/bondery

# --- Email ---
# From address for transactional email
BONDERY_PRIVATE_EMAIL_ADDRESS=robot@example.com
# SMTP host
BONDERY_PRIVATE_EMAIL_HOST=smtp.example.com
# SMTP password
BONDERY_PRIVATE_EMAIL_PASS=your-email-password
# SMTP port
BONDERY_PRIVATE_EMAIL_PORT=587
# SMTP username
BONDERY_PRIVATE_EMAIL_USER=robot@example.com

# --- Infra ---
# Chrome Web Store extension ID. Used to derive the https://{id}.chromiumapp.org/ redirect URI registered for the extension's OAuth client (see scripts/provision-oauth-clients.ts).
BONDERY_INFRA_CHROME_EXTENSION_ID=lpcmokfekjjejnpobhbkgmjkodfhpmha

# --- Maps ---
# Mapy.com API key
BONDERY_PRIVATE_MAPS_KEY=<your-maps-api-key>
# Mapy.com API base URL
BONDERY_PUBLIC_MAPS_URL=https://api.mapy.com

# --- Stripe ---
# Stripe API secret key
BONDERY_PRIVATE_STRIPE_SECRET_KEY=sk_live_<your-stripe-secret-key>
# Stripe webhook signing secret
BONDERY_PRIVATE_STRIPE_WEBHOOK_SECRET=whsec_<your-stripe-webhook-secret>
# Enable in-app subscription upgrades (true | false)
BONDERY_PUBLIC_BILLING_UPGRADES_ENABLED=false
# Stripe publishable key for embedded Checkout
BONDERY_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_<your-stripe-publishable-key>
# Stripe Price IDs
BONDERY_PUBLIC_STRIPE_PRICE_ID_MONTHLY=price_<monthly>
BONDERY_PUBLIC_STRIPE_PRICE_ID_ANNUAL=price_<annual>

# --- Public URLs ---
# Public API base URL (no trailing /api)
BONDERY_PUBLIC_API_URL=https://api.usebondery.com
# Comma-separated extra CORS origins (e.g. Expo web)
BONDERY_PUBLIC_EXTRA_ALLOWED_ORIGINS=http://localhost:26634
# Public webapp origin
BONDERY_PUBLIC_WEBAPP_URL=https://app.usebondery.com
# Public marketing website origin
BONDERY_PUBLIC_WEBSITE_URL=https://usebondery.com

# --- Redis ---
# Redis connection URL
BONDERY_PRIVATE_REDIS_URL=redis://127.0.0.1:26636

# --- Storage (SeaweedFS S3 gateway) ---
BONDERY_PRIVATE_S3_ACCESS_KEY_ID=bondery_access_key
BONDERY_PRIVATE_S3_ENDPOINT=http://seaweedfs-s3:8333
BONDERY_PRIVATE_S3_REGION=eu-central-1
BONDERY_PRIVATE_S3_SECRET_ACCESS_KEY=bondery_secret_key_change_me
BONDERY_PUBLIC_STORAGE_URL=https://storage.usebondery.com

  "name": "website",
  "private": true,
  "scripts": {
    "announce": "tsx scripts/announce.ts",
    "build": "next build",
    "check:docs:mdx": "tsx scripts/check-docs-mdx.ts",
    "check:env": "tsx scripts/check-env.ts",
    "check:types": "node ../../scripts/tsc-native.mjs --noEmit",

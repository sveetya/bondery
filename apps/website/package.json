    "generate-icons": "tsx scripts/generate-icons.ts",
    "generate:api-docs": "tsx scripts/generate-api-docs.ts",
    "prebuild": "cross-env NODE_ENV=production npm run check:env && npm run generate-icons && npm run generate:api-docs",
    "predev": "node ../../scripts/kill-website-dev.mjs && cross-env NODE_ENV=development npm run check:env && npm run generate-icons && npm run generate:api-docs",
    "start": "next start"
  },

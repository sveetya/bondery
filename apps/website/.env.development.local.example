# Generated by pnpm run env — do not edit by hand. Edit root .env.local instead.

# --- Analytics ---
# Plausible site domain (marketing hostname registered in self-hosted Plausible CE)
BONDERY_PUBLIC_PLAUSIBLE_DOMAIN=""
# Self-hosted Plausible CE base URL (script and event requests)
BONDERY_PUBLIC_PLAUSIBLE_HOST=""
# Disable analytics / vendor telemetry when true
DO_NOT_TRACK=true

# --- Infra ---
# Git SHA surfaced in runtime config and health probes
BONDERY_INFRA_GIT_SHA=""
# Product version: pins api and webapp container images to ghcr.io/usebondery/{api,webapp}:X.Y.Z when set; also surfaced in runtime config and health probes. Omit for floating :production channel.
BONDERY_INFRA_VERSION=""

# --- Public URLs ---
# Public webapp origin
BONDERY_PUBLIC_WEBAPP_URL=http://localhost:26632
# Public marketing website origin
BONDERY_PUBLIC_WEBSITE_URL=http://localhost:26630


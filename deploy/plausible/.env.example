# =============================================================================
# Plausible Community Edition — Dokploy env UI or compose .env
# Generated by pnpm run env — do not edit by hand. Edit packages/helpers/src/env/manifest.ts.
# docker compose -f deploy/plausible/compose.yml --env-file deploy/plausible/.env up -d
# =============================================================================

# --- Public hostname ---
# Traefik Host() rule (no scheme). Compose derives BASE_URL as https://<domain>.
BONDERY_INFRA_PLAUSIBLE_DOMAIN=plausible.usebondery.com

# --- Plausible secrets ---
# Generate:
#   openssl rand -base64 48   # BONDERY_PRIVATE_PLAUSIBLE_SECRET_KEY_BASE
#   openssl rand -base64 32   # BONDERY_PRIVATE_PLAUSIBLE_TOTP_VAULT_KEY
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32   # BONDERY_PRIVATE_PLAUSIBLE_POSTGRES_PASSWORD
# Compose builds DATABASE_URL from the Postgres password — do not set DATABASE_URL in Dokploy.
BONDERY_PRIVATE_PLAUSIBLE_POSTGRES_PASSWORD=""
BONDERY_PRIVATE_PLAUSIBLE_SECRET_KEY_BASE=""
BONDERY_PRIVATE_PLAUSIBLE_TOTP_VAULT_KEY=""

# --- Plausible options ---
# Compose maps these to Plausible CE container env (BASE_URL, DISABLE_REGISTRATION).
BONDERY_INFRA_PLAUSIBLE_DISABLE_REGISTRATION=invite_only


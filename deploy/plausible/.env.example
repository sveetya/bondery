# =============================================================================
# Plausible Community Edition — copy to .env for Dokploy / local smoke
# docker compose -f deploy/plausible/compose.yml --env-file deploy/plausible/.env up -d
# =============================================================================

# --- Public hostname ---
# Traefik Host() rule (no scheme). Also used to derive BASE_URL below.
BONDERY_INFRA_PLAUSIBLE_DOMAIN=plausible.usebondery.com

# --- Plausible CE (required) ---
# Public URL where Plausible is reachable (must match DNS + TLS).
BASE_URL=https://plausible.usebondery.com
# Generate: openssl rand -base64 48
SECRET_KEY_BASE=
# Generate: openssl rand -base64 32
TOTP_VAULT_KEY=

# --- Plausible CE (optional) ---
# HTTP_PORT=80
# DISABLE_REGISTRATION=invite_only
# PLAUSIBLE_POSTGRES_PASSWORD=postgres
# DATABASE_URL=postgresql://postgres:postgres@plausible_db:5432/plausible
# CLICKHOUSE_DATABASE_URL=http://plausible_events_db:8123/plausible_events_db

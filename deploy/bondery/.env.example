# =============================================================================
# Bondery stack — copy to .env and fill secrets
# docker compose -f deploy/bondery/docker-compose.yml --env-file deploy/bondery/.env up -d
# =============================================================================

# --- Image tags (optional) ---
# Omit to pull the floating "production" channel. Pin to semver (e.g. 1.7.4) for
# reproducible deploys / explicit rollback.
# BONDERY_INFRA_API_IMAGE_TAG=1.7.4
# BONDERY_INFRA_WEBAPP_IMAGE_TAG=1.7.4

# --- Public hostnames (no scheme) ---
# Traefik Host() rules use these; Compose derives https://… URLs for the apps.
BONDERY_INFRA_API_DOMAIN=api.usebondery.com
BONDERY_INFRA_WEBAPP_DOMAIN=app.usebondery.com
BONDERY_INFRA_WEBSITE_DOMAIN=usebondery.com
# Chrome Web Store ID — API Auth allow-list includes https://{id}.chromiumapp.org/
BONDERY_INFRA_CHROME_EXTENSION_ID=lpcmokfekjjejnpobhbkgmjkodfhpmha

# --- Bundled Redis (default). Advanced: run API alone with a managed Redis URL. ---
BONDERY_PRIVATE_REDIS_URL=redis://redis:6379

# --- Postgres (bundled) ---
BONDERY_PRIVATE_POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# --- Better Auth (API) ---
# Format: version:secret[,version:secret...]; highest version first
BONDERY_PRIVATE_BETTER_AUTH_SECRETS=1:your-super-secret-better-auth-secret-min-32-chars
BONDERY_PRIVATE_AUTH_GITHUB_CLIENT_ID=
BONDERY_PRIVATE_AUTH_GITHUB_CLIENT_SECRET=
BONDERY_PRIVATE_AUTH_LINKEDIN_CLIENT_ID=
BONDERY_PRIVATE_AUTH_LINKEDIN_CLIENT_SECRET=
# Internal service-to-service HMAC secret
BONDERY_PRIVATE_SERVICE_SECRET=your-service-secret-min-32-chars

# Webapp BFF OAuth client (provisioned at deploy; never exposed to browsers)
BONDERY_PUBLIC_WEBAPP_OAUTH_CLIENT_ID=
BONDERY_PRIVATE_WEBAPP_OAUTH_CLIENT_SECRET=
BONDERY_PRIVATE_WEBAPP_SESSION_SECRET=your-super-secret-webapp-session-secret-min-32-chars

# Chrome extension public OAuth client id
BONDERY_PUBLIC_OAUTH_CLIENT_ID=

# --- Storage (SeaweedFS S3) ---
# S3 credentials are rendered into SeaweedFS at container start (see deploy/bondery/seaweedfs/entrypoint.sh).
BONDERY_INFRA_STORAGE_DOMAIN=storage.usebondery.com
BONDERY_PRIVATE_S3_ENDPOINT=http://seaweedfs-s3:8333
BONDERY_PRIVATE_S3_REGION=eu-central-1
BONDERY_PRIVATE_S3_ACCESS_KEY_ID=bondery_access_key
BONDERY_PRIVATE_S3_SECRET_ACCESS_KEY=bondery_secret_key_change_me
BONDERY_PUBLIC_STORAGE_URL=https://storage.usebondery.com

# --- API secrets (env_file → api only; never injected into webapp) ---

BONDERY_PRIVATE_EMAIL_HOST=smtp.example.com
BONDERY_PRIVATE_EMAIL_PORT=465
BONDERY_PRIVATE_EMAIL_USER=username
BONDERY_PRIVATE_EMAIL_PASS=your-email-password
BONDERY_PRIVATE_EMAIL_ADDRESS=robot@usebondery.com

BONDERY_PRIVATE_STRIPE_WEBHOOK_SECRET=whsec_<your-stripe-webhook-secret>
BONDERY_PRIVATE_STRIPE_SECRET_KEY=sk_live_<your-stripe-secret-key>
BONDERY_PUBLIC_BILLING_UPGRADES_ENABLED=false
BONDERY_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_<your-stripe-publishable-key>
BONDERY_PUBLIC_STRIPE_PRICE_ID_MONTHLY=price_<monthly>
BONDERY_PUBLIC_STRIPE_PRICE_ID_ANNUAL=price_<annual>

# Optional integrations (API)
BONDERY_PRIVATE_ANTHROPIC_API_KEY=
BONDERY_PUBLIC_MAPS_URL=https://api.mapy.com
BONDERY_PRIVATE_MAPS_KEY=

# Optional webapp analytics (allowlisted into webapp only)
BONDERY_PUBLIC_POSTHOG_KEY=
BONDERY_PUBLIC_POSTHOG_HOST=
BONDERY_PRIVATE_POSTHOG_KEY=
BONDERY_PRIVATE_POSTHOG_HOST=

# Optional API admin analytics (env_file → api only)
BONDERY_PRIVATE_POSTHOG_API_SECRET=
BONDERY_PRIVATE_POSTHOG_PROJECT_ID=

# Optional build metadata (surfaced in webapp runtime config / status)
BONDERY_INFRA_VERSION=1.7.4
BONDERY_INFRA_GIT_SHA=

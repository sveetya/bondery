{
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@prisma/engines@7.9.1": true,
    "@swc/core@1.15.43": true,
    "core-js-pure@3.49.0": true,
    "core-js@3.49.0": true,
    "esbuild@0.27.4": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.1": true,
    "protobufjs@7.6.4": true,
    "sharp@0.34.5": true,
    "spawn-sync@1.0.15": true
  },
  "browserslist": {
    "development": [
      "chrome >= 111",
      "edge >= 111",
      "firefox >= 140",
      "safari >= 18.4",
      "ios_saf >= 18.4"
    ],
    "production": [
      "chrome >= 111",
      "edge >= 111",
      "firefox >= 140",
      "safari >= 18.4",
      "ios_saf >= 18.4",
      "and_chr >= 111"
    ]
  },
  "dependencies": {
    "freeport-async": "^2.0.0",
    "mcp-remote": "^0.1.38"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@bondery/schemas": "*",
    "@redocly/cli": "^2.38.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "turbo": "^2.10.4",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "name": "bondery-monorepo",
  "overrides": {
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-bubble-menu": "3.29.2",
    "@tiptap/extension-color": "3.29.2",
    "@tiptap/extension-emoji": "3.29.2",
    "@tiptap/extension-floating-menu": "3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-list": "3.29.2",
    "@tiptap/extension-mention": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extension-task-item": "3.29.2",
    "@tiptap/extension-task-list": "3.29.2",
    "@tiptap/extension-text-style": "3.29.2",
    "@tiptap/extensions": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@tiptap/suggestion": "3.29.2",
    "next": "16.3.0-canary.102",
    "postcss": "^8.5.17",
    "zod-openapi": "^6.0.0"
  },
  "packageManager": "npm@11.12.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:api": "turbo build --filter=api",
    "build:chrome-extension": "turbo build --filter=chrome-extension",
    "build:mobile": "turbo build --filter=mobile",
    "build:packages": "turbo compile --filter=./packages/*",
    "build:translations": "turbo build --filter=@bondery/translations",
    "build:webapp": "turbo build --filter=webapp",
    "build:website": "turbo build --filter=website",
    "check": "biome ci . && npm run check:package-imports && npm run build -w @bondery/helpers && npm run env:check && npm run check:docs && npm run check:openapi && npm run test:webapp:runtime-config && npm run check:contracts && npm run check:types && npm run check:i18n && npm run check:api-errors && npm run test:api:sync",
    "check:api-errors": "npm run check:api-errors:catalog && npm run check:api-errors:translations && npm run check:api-errors:client-display",
    "check:api-errors:catalog": "node scripts/check-api-errors-catalog.mjs",
    "check:api-errors:client-display": "node scripts/check-api-errors-client-display.mjs",
    "check:api-errors:translations": "node scripts/check-api-errors-translations.mjs",
    "check:contracts": "npm run check:contracts -w @bondery/schemas",
    "check:docs": "npm run check:docs:links && npm run check:docs:mdx",
    "check:docs:links": "node scripts/check-docs-links.mjs",
    "check:docs:mdx": "npm run check:docs:mdx -w website",
    "check:extension-patterns": "npm run check:extension-patterns -w chrome-extension",
    "check:i18n": "npm run check:i18n:structure && npm run check:i18n:types && npm run check:i18n:usage && npm run check:i18n:lint",
    "check:i18n:lint": "npm run check:i18n:lint -w @bondery/translations",
    "check:i18n:structure": "node packages/translations/scripts/check-i18n-structure.mjs",
    "check:i18n:types": "npm run check:i18n:types -w @bondery/translations",
    "check:i18n:usage": "npm run check:i18n:usage -w @bondery/translations",
    "check:openapi": "npm run check:openapi-spec -w api && npx redocly lint packages/openapi-spec/openapi.yaml",
    "check:package-imports": "node scripts/check-package-imports.mjs",
    "check:sync-patterns": "npm run check:sync-patterns -w mobile",
    "check:types": "turbo check:types",
    "db:functions": "npm run db:functions -w @bondery/db",
    "db:generate": "npm run db:generate -w @bondery/db",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @bondery/db",
    "db:migrate:dev": "npm run db:migrate:dev -w @bondery/db",
    "db:studio": "npm run db:studio -w @bondery/db",
    "db:validate": "npm run db:validate -w @bondery/db",
    "dev": "turbo watch dev --concurrency 20",
    "dev:api": "turbo watch api#dev --concurrency 20",
    "dev:chrome-extension": "turbo watch chrome-extension#dev --concurrency 20",
    "dev:emails": "turbo watch @bondery/emails#preview --concurrency 20",
    "dev:extension": "turbo watch webapp#dev api#dev chrome-extension#dev website#dev --concurrency 20",
    "dev:mobile": "turbo watch api#dev mobile#dev --concurrency 20",
    "dev:stripe-webhook": "npx localtunnel --port 26631",
    "dev:webapp": "turbo watch webapp#dev --concurrency 20",
    "dev:webapp-api": "turbo watch webapp#dev api#dev --concurrency 20",
    "dev:webapp-api-emails": "turbo watch webapp#dev api#dev @bondery/emails#preview --concurrency 20",
    "dev:website": "turbo watch website#dev --concurrency 20",
    "env": "node --import tsx scripts/env.ts --all",
    "env:check": "node --import tsx scripts/env.ts --check",
    "env:development": "node --import tsx scripts/env.ts --development",
    "env:examples": "node scripts/generate-env-examples.mjs",
    "env:production": "node --import tsx scripts/env.ts --production",
    "env:pull": "node --import tsx scripts/env-pull.ts",
    "generate:doc-links": "node scripts/generate-doc-links.mjs",
    "generate:openapi": "turbo generate:openapi --filter=api",
    "github:repo-settings": "bash .github/scripts/apply-repo-settings.sh",
    "github:rulesets": "bash .github/scripts/apply-rulesets.sh",
    "i18n:status": "npm run i18n:status -w @bondery/translations",
    "i18n:types": "npm run i18n:types -w @bondery/translations",
    "kill:dev": "node scripts/kill-dev-servers.mjs",
    "lint": "biome check --write .",
    "prepare": "husky",
    "provision:oauth-clients": "npm run provision-oauth-clients:dev -w api",
    "provision:platform-admins": "npm run provision-platform-admins:dev -w api",
    "release-migrate": "npm run release-migrate -w @bondery/db",
    "setup:dev": "node --import tsx scripts/setup-dev.ts",
    "setup:seaweedfs": "npm run build:api && node --env-file=.env.local apps/api/dist/cli/ensure-storage-buckets.js",
    "start:apps": "turbo start",
    "start:postgres": "docker compose -f deploy/bondery/docker-compose.dev-db.yml --env-file .env.local up -d",
    "start:redis": "docker compose -f deploy/bondery/docker-compose.dev-redis.yml up -d",
    "start:seaweedfs": "docker compose -f deploy/bondery/docker-compose.seaweedfs.yml -f deploy/bondery/docker-compose.seaweedfs.dev.yml --env-file .env.local up -d",
    "stop:postgres": "docker compose -f deploy/bondery/docker-compose.dev-db.yml --env-file .env.local down",
    "stop:redis": "docker compose -f deploy/bondery/docker-compose.dev-redis.yml down",
    "stop:seaweedfs": "docker compose -f deploy/bondery/docker-compose.seaweedfs.yml -f deploy/bondery/docker-compose.seaweedfs.dev.yml --env-file .env.local down",
    "sync-exports": "node scripts/sync-package-exports.mjs",
    "test:api": "npm run test:api -w api",
    "test:api:sync": "npm run test:sync -w api",
    "test:auth": "npm run test:auth -w api",
    "test:mobile:sync": "npm run test:sync -w mobile",
    "test:webapp:runtime-config": "npm run test:runtime-config -w webapp",
    "test:webapp:sync": "npm run test:sync -w webapp",
    "test:webapp:theme": "npm run test:theme -w webapp",
    "tsc-native": "node scripts/tsc-native.mjs",
    "turbo:clean": "turbo daemon clean"
  },
  "version": "1.7.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

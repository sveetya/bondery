{
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@supabase/supabase-js": "^2.111.0"
  },
  "description": "Archived Supabase CLI project, migrations, and one-off migration scripts (reference only).",
  "devDependencies": {
    "supabase": "^2.109.1",
    "tsx": "^4.23.0"
  },
  "name": "supabase-db",
  "private": true,
  "scripts": {
    "db:seed": "npx supabase db seed",
    "gen-types": "npx supabase gen types typescript --local > ../../packages/schemas/src/supabase.types.ts",
    "get:service-key": "npx tsx scripts/seed-vault-service-key.ts",
    "link": "npx supabase link",
    "migrate-auth-from-supabase": "tsx scripts/migrate-auth-from-supabase.ts",
    "migrate-storage-from-supabase": "tsx --env-file=.env.local scripts/migrate-storage-from-supabase.ts",
    "migration:new": "npx supabase migration new",
    "pull": "npx supabase db pull",
    "push": "npx supabase db push",
    "reset": "npx supabase db reset",
    "setup:beta": "npx tsx scripts/setup.ts --env beta",
    "setup:local": "npx tsx scripts/setup.ts --env local",
    "setup:production": "npx tsx scripts/setup.ts --env production",
    "stack:bootstrap:greenfield": "npx tsx scripts/setup.ts --bootstrap greenfield",
    "stack:bootstrap:import": "npx tsx scripts/setup.ts --bootstrap import",
    "stack:migrate-storage": "npx tsx scripts/migrate-storage-from-cloud.ts",
    "start": "npx supabase start",
    "stop": "npx supabase stop",
    "upload:secrets": "npx supabase secrets set --env-file .env.beta --project-ref <your-project-ref>"
  },
  "version": "1.7.4"
}

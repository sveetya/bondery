{
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@supabase/supabase-js": "^2.111.0"
  },
  "description": "Archived Supabase CLI project, migrations, and one-off migration scripts (reference only).",
  "devDependencies": {
    "supabase": "^2.109.1",
    "tsx": "^4.23.0"
  },
  "name": "supabase-db",
  "private": true,
  "scripts": {
    "db:seed": "pnx supabasedb seed",
    "gen-types": "pnx supabasegen types typescript --local > ../../packages/schemas/src/supabase.types.ts",
    "get:service-key": "pnpm exec tsx scripts/seed-vault-service-key.ts",
    "link": "pnx supabaselink",
    "migrate-auth-from-supabase": "tsx scripts/migrate-auth-from-supabase.ts",
    "migrate-storage-from-supabase": "tsx --env-file=.env.local scripts/migrate-storage-from-supabase.ts",
    "migration:new": "pnx supabasemigration new",
    "pull": "pnx supabasedb pull",
    "push": "pnx supabasedb push",
    "reset": "pnx supabasedb reset",
    "setup:beta": "pnpm exec tsx scripts/setup.ts --env beta",
    "setup:local": "pnpm exec tsx scripts/setup.ts --env local",
    "setup:production": "pnpm exec tsx scripts/setup.ts --env production",
    "stack:bootstrap:greenfield": "pnpm exec tsx scripts/setup.ts --bootstrap greenfield",
    "stack:bootstrap:import": "pnpm exec tsx scripts/setup.ts --bootstrap import",
    "stack:migrate-storage": "pnpm exec tsx scripts/migrate-storage-from-cloud.ts",
    "start": "pnx supabasestart",
    "stop": "pnx supabasestop",
    "upload:secrets": "pnx supabasesecrets set --env-file .env.beta --project-ref <your-project-ref>"
  },
  "version": "1.8.0"
}

# Generated by npm run env — do not edit by hand. Edit root .env.local instead.

# --- Database ---
# Generate a Postgres password:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32   # BONDERY_PRIVATE_POSTGRES_PASSWORD
# Use the same password in DATABASE_URL (postgresql://postgres:<password>@...).
# Postgres password for bundled self-hosted database
BONDERY_PRIVATE_POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
# Postgres connection string (Prisma + API)
DATABASE_URL=postgresql://postgres:password@127.0.0.1:54322/bondery


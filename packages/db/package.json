{
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@bondery/helpers": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-email/ui": "^6.9.1",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv": "^17.2.3",
    "fastify-zod-openapi": "^5.7.0",
    "i18next-cli": "^1.67.3",
    "pg": "^8.16.3",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1",
    "react-i18next": "^17.0.11",
    "tsx": "^4.23.1"
  },
  "description": "Prisma schema, generated client, and raw SQL functions for the Bondery Postgres database.",
  "devDependencies": {
    "@bondery/typescript-config": "workspace:*",
    "@types/pg": "^8.15.6",
    "dotenv-cli": "^11.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./src/index.ts"
    },
    "./client": {
      "default": "./dist/client.js",
      "types": "./src/client.ts"
    },
    "./release-migrate": {
      "default": "./dist/release-migrate.js",
      "types": "./src/release-migrate.ts"
    }
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "main": "./dist/index.js",
  "name": "@bondery/db",
  "private": true,
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc",
    "check:types": "tsc --noEmit",
    "db:functions": "tsx --env-file=.env.local scripts/apply-sql-functions.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e .env.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:validate": "dotenv -e .env.local -- prisma validate",
    "release-migrate": "tsx scripts/release-migrate.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.8.2"
}

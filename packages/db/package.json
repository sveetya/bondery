{
  "name": "@bondery/db",
  "version": "1.7.4",
  "private": true,
  "description": "Prisma schema, generated client, and raw SQL functions for the Bondery Postgres database. Replaces @bondery/schemas/supabase.types and apps/supabase-db.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc",
    "check-types": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:functions": "tsx --env-file=.env.local scripts/apply-sql-functions.ts",
    "release-migrate": "tsx scripts/release-migrate.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@bondery/helpers": "*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "prisma": "^7.9.1",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@bondery/typescript-config": "*",
    "@types/pg": "^8.15.6",
    "dotenv-cli": "^11.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
